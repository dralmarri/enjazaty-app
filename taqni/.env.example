# تقني — Supabase project credentials (PLACEHOLDER — independent project from
# Enjazaty's; do NOT reuse the enjazaty-app-1 Supabase project/URL/keys here).
# Copy this file to `.env` inside taqni/ and fill in the real values once the
# تقني Supabase project has been created at https://supabase.com/dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-TAQNI-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-TAQNI-ANON-KEY
