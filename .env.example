# =========================================================================
# Enjazaty (إنجازاتي) — Environment variables
# Copy this file to ".env" and fill in your real Supabase project values.
# These are read at build time via Expo (the EXPO_PUBLIC_ prefix exposes
# them to the client bundle — only use the public anon key here, never the
# service-role key).
# =========================================================================

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Your Supabase "anon" public API key (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
